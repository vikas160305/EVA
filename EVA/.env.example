# Safe local configuration template for Mark L.
# Copy this file to a real .env in your machine and keep it out of source control.
# Do not commit secrets or private file contents to the repository.
# Use environment variables or a local .env file outside the repository; never
# store real API keys, tokens, or certificates in versioned files.

MARK_L_GEMINI_API_KEY=replace_with_your_gemini_api_key
MARK_L_GEMINI_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
MARK_L_SEARCH_MODE=search
MARK_L_CACHE_TTL_SECONDS=30
MARK_L_LOG_LEVEL=INFO
MARK_L_TIMEOUT_SECONDS=60.0
MARK_L_ALLOW_BACKGROUND_TASKS=true
MARK_L_ALLOW_WINDOWS_SUBPROCESS_HIDE=true
MARK_L_SAFE_HOME=${HOME}
MARK_L_MANIFEST_PATH=config/api_keys.json

# Optional local debug/diagnostic tuning
# MARK_L_DIAGNOSTIC_TRACE=1
# MARK_L_DIAGNOSTIC_LOG=0
